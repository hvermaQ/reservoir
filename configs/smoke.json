{
  "name": "smoke",
  "description": "Tiny end-to-end validation of every code path, including both negative controls and all three families. No scientific content.",
  "margins": {"acc": 0.01, "NRMSE": 0.02},
  "primary": {"family": "classification", "metric": "acc", "arm_a": "quantum",
              "arm_b": "random_unitary", "margin": 0.01},
  "experiments": [
    {"family": "classification", "tasks": [{"dataset": "digits"}], "seeds": [0, 1],
     "grid": {"n_pca": [8], "num_memory": [2], "model": ["XXZ"], "n_reupload": [1],
              "total_time": [0.2], "shots": [0],
              "control": ["none", "shuffle_labels", "shuffle_features"]}},
    {"family": "timeseries", "tasks": [{"dataset": "narma10", "n": 600}], "seeds": [0, 1],
     "grid": {"W": [10], "num_memory": [2], "model": ["XXZ"], "total_time": [0.2],
              "encoding": ["continuous"], "shots": [0], "control": ["none"]}},
    {"family": "streaming", "tasks": [{"dataset": "narma10", "n": 600}], "seeds": [0, 1],
     "grid": {"num_memory": [2], "model": ["XXZ"], "total_time": [0.2],
              "encoding": ["continuous"], "n_tap": [1, 3], "washout": [30],
              "n_lags": [10], "max_lag": [10], "shots": [0]}},
    {"family": "classification", "tasks": [{"dataset": "digits"}], "seeds": [0],
     "grid": {"n_pca": [8], "num_memory": [2], "model": ["XXZ", "IAA_LOCALIZED"],
              "n_reupload": [1], "entropy_target": [0.4], "shots": [0]}}
  ]
}
